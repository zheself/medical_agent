# ============================================================
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================================

# ----------- Neo4j (KG 后端) -----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ----------- vLLM (主 LLM 服务) -----------
LLM_ENDPOINT=http://localhost:8000/v1
LLM_MODEL_NAME=Qwen3-8B
LLM_API_KEY=EMPTY

# ----------- L2 Verifier (蒸馏小模型) -----------
VERIFIER_ENDPOINT=http://localhost:8001/v1
VERIFIER_MODEL_NAME=qwen2.5-1.5b-verifier

# ----------- Zilliz / Milvus (向量库) -----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=medical_communities

# ----------- PostgreSQL (Episodic Memory 结构化字段) -----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medical_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ----------- Redis (Working Memory Session 池) -----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ----------- Embedder -----------
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDER_DEVICE=cuda:0

# ----------- 配置 -----------
LOG_LEVEL=INFO
ENABLE_SPECULATIVE_PREFETCH=true
ENABLE_SELF_CRITIQUE=true
MAX_REFLEXION_ITERATIONS=2
WORKING_MEMORY_MAX_TOKENS=4000
EPISODIC_IMPORTANCE_THRESHOLD=0.3
